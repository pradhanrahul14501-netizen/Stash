{
  "manifest_version": 3,
  "name": "Stash",
  "version": "0.2.2",
  "description": "Save browser copies to your private Stash library.",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5050/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stash",
    "default_popup": "popup.html"
  }
}
